FROM python:3.12-slim-bookworm@sha256:2ed6491b93cd49272ee6de2b5a38440c3448360322c089fc23e370722d74179d
LABEL org.opencontainers.image.source="https://github.com/jefffm/household-audio-fabric"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements.lock
COPY fetch_voice.py voices.lock.json /app/
RUN python fetch_voice.py /opt/voice
COPY LICENSE LICENSES.md /usr/share/doc/household-announcer/
COPY announcer /app/announcer
RUN mkdir /data && chown 1000:1000 /data
USER 1000:1000
EXPOSE 18083 18084
ENTRYPOINT ["python", "-m", "announcer.main"]
