#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
python3 -m unittest discover -s tests -v
if [[ "${SKIP_INTEGRATION:-0}" == "1" ]]; then
  exit 0
fi
export COMPOSE_PROJECT_NAME="household-audio-snapserver-test-$$"
case "$COMPOSE_PROJECT_NAME" in
  household-audio-snapserver-test-*) ;;
  *) echo "refusing unsafe Compose project: $COMPOSE_PROJECT_NAME" >&2; exit 2 ;;
esac
TEST_ROOT="$(mktemp -d)"
export TEST_OUTPUT_DIR="$TEST_ROOT/output"
mkdir -p "$TEST_OUTPUT_DIR"
chmod 0777 "$TEST_OUTPUT_DIR"
cleanup() {
  case "$COMPOSE_PROJECT_NAME" in
    household-audio-snapserver-test-*) docker compose --profile test down --volumes --remove-orphans ;;
    *) echo "refusing unsafe cleanup" >&2 ;;
  esac
  rm -rf "$TEST_ROOT"
}
trap cleanup EXIT
docker compose --profile test up --build --detach --wait
if ! python3 tests/integration.py; then
  docker compose --profile test logs snapserver snapclient-test >&2
  exit 1
fi
docker compose --profile test logs snapclient-test > "$TEST_ROOT/snapclient.log"
grep -q "Connected to" "$TEST_ROOT/snapclient.log"
