// Rendered by entrypoint.sh. stdout/pipe carry raw headerless PCM only.
general = {
  name = "@@AIRPLAY_NAME@@";
  interface = "@@AIRPLAY_INTERFACE@@";
  service_type = "airplay2";
  airplay_device_id = 0x@@AIRPLAY_DEVICE_ID@@L;
  output_backend = "@@OUTPUT_BACKEND@@";
  mdns_backend = "avahi";
  playback_mode = "stereo";
  // Apply sender volume/mute to this source's PCM, not Snapcast endpoint volume.
  ignore_volume_control = "no";
  // Patched AirPlay 2 event, control, and data listeners are confined here.
  udp_port_base = 6001;
  udp_port_range = 10;
};

stdout = {
  output_rate = 48000;
  output_format = "S32_LE";
  output_channels = 2;
};

pipe = {
  name = "/run/airplay/audio";
  output_rate = 48000;
  output_format = "S32_LE";
  output_channels = 2;
};

metadata = {
  enabled = "yes";
  include_cover_art = "no";
  pipe_name = "/run/airplay/metadata";
};

diagnostics = {
  log_verbosity = 1;
};
